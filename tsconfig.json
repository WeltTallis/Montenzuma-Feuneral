{
    "compilerOptions": {
        "target": "ES2020",
        "module": "commonjs",
        "lib": [
            "ES2020"
        ],
        "outDir": "./dist",
        "rootDir": "./",
        "strict": true,
        "esModuleInterop": true,
        "skipLibCheck": true,
        "forceConsistentCasingInFileNames": true,
        "resolveJsonModule": true,
        "declaration": true,
        "sourceMap": true
    },
    "include": [
        "**/*.ts",
        "FrontendClient/client/src/components/analysis/new/feuneral/ui/select.tsx",
        "services/documents-service/server.js"
    ],
    "exclude": [
        "node_modules",
        "dist",
        "**/*.js"
    ]
}