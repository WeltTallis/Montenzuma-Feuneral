pipeline {
    agent any

    environment {
        NODE_ENV = 'development'
    }

    stages {
        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Install Dependencies') {
            steps {
                // Use 'npm ci' for reliable builds
                sh 'npm ci'
            }
        }

        stage('Linting') {
            steps {
                // Run ESLint
                sh 'npm run lint'
            }
        }

        stage('Path Sanity') {
            steps {
                // Fails fast when a service uses one '../' too many and would die
                // at require-time inside the image (Cannot find module).
                sh 'npm run check:paths'
            }
        }

        stage('Build Docker Image') {
            steps {
                script {
                    dockerImage = docker.build("backend-api:${env.BUILD_ID}")
                }
            }
        }
    }

    post {
        always {
            cleanWs()
        }
    }
}
