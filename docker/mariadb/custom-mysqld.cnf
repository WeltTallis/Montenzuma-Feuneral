# =============================================================================
# RestPoint - MariaDB custom configuration (Prometheus monitoring coverage)
# =============================================================================
# Mounted at /etc/mysql/conf.d/custom-mysqld.cnf inside the mariadb:10.11 image.
#
# These settings guarantee the Prometheus mysql_exporter can expose EVERY metric
# the stack needs: slow queries, connections, the listening port, InnoDB stats,
# and the performance_schema detail (per-digest slow-query breakdown, waits,
# table/index/file/memory events).
#
# NOTE: options here are only read at server start. Restarting the mariadb
# service is enough - no data-volume wipe / re-initialisation required.
# =============================================================================

[mysqld]

# All SQL-generated timestamps are stored and returned in UTC. Application
# clients can convert to a user's display timezone at the presentation layer.
default-time-zone = '+00:00'

# --- Performance Schema (required by the perf_schema scrapers) ---------------
# The exporter's perf_schema collectors read from performance_schema tables
# (events_statements_summary_by_digest, table_io_waits_*, file/memory events).
# It is ON by default in MariaDB 10.11 but we set it explicitly for safety.
performance_schema = ON

# --- Slow query log (drives `mysql_global_status_slow_queries`) --------------
# When enabled, MariaDB increments the `Slow_queries` counter for every query
# whose execution time exceeds long_query_time. The exporter exposes this
# counter as `mysql_global_status_slow_queries` (slow query volume) and, with
# performance_schema enabled, per-digest timing via perf_schema.eventsstatements.
slow_query_log = ON
long_query_time = 1

# TABLE keeps the slow log queryable (mysql.slow_log) and bounded in size,
# while still incrementing the Slow_queries counter the exporter reads.
log_output = TABLE

# --- General / error log -----------------------------------------------------
# general_log is intentionally OFF (very verbose, hurts performance).
general_log = OFF
log_warnings = 2

# --- Connection / thread tuning ----------------------------------------------
# Helps expose meaningful, actionable connection metrics.
#
# max_connections MUST be sized for the whole mesh, not one client. This stack
# runs ~20 Node services, and EVERY one of them opens its own pools against
# this server (see shared/dbConfig.ts): a 5-connection root pool plus one
# 10-connection pool PER TENANT DATABASE (up to 50 cached tenants per service).
# The previous 500 was therefore reachable from a single busy service, and once
# the limit was hit the healthcheck's own `--connect` probe (mysqladmin ping)
# was refused a slot too — so MariaDB flipped to `unhealthy` even while it was
# serving fine, and `condition: service_healthy` on api-gateway kept the UI
# from ever starting. 1000 gives real headroom for the mesh; raise further only
# together with the RAM to back it (each connection costs buffer memory).
max_connections = 1000
thread_cache_size = 100

# Idle-socket reaping. The previous 28800s (8h) meant a leaked/lingering client
# socket held its slot for the rest of the workday, so a transient burst could
# permanently saturate max_connections with nothing actually using it. Client
# pools already close idle connections long before this (5 min in
# shared/dbConfig.ts), so 600s only ever catches genuine leaks. It applies to
# IDLE sockets only — a running query is governed by max_execution_time, which
# stays unset, so long migrations and reports are unaffected.
wait_timeout = 600
interactive_timeout = 600
connect_timeout = 10
