{
  "$schema": "https://biomejs.dev/schemas/1.9.4/schema.json",
  
  "organizeImports": {
    "enabled": true
  },

  "linter": {
    "enabled": true,
    "rules": {
      "recommended": true,
      
      "suspicious": {
        "noArrayIndexKey": "error",
        "noAssignInExpressions": "error",
        "noAsyncPromiseExecutor": "error",
        "noCommentText": "error",
        "noConsoleLog": "warn",
        "noDebugger": "error",
        "noDoubleEquals": "error",
        "noDuplicateCase": "error",
        "noDuplicateClassMembers": "error",
        "noDuplicateJsxProps": "error",
        "noDuplicateObjectKeys": "error",
        "noDuplicateParameters": "error",
        "noEmptyInterface": "error",
        "noExplicitAny": "off",
        "noExtraNonNullAssertion": "error",
        "noFallthroughSwitchClause": "error",
        "noFunctionAssign": "error",
        "noGlobalAssign": "error",
        "noImportAssign": "error",
        "noMisleadingCharacterClass": "error",
        "noMisleadingInstantiator": "error",
        "noNonNullAssertion": "warn",
        "noObjectDefinePropertyArguments": "error",
        "noPrototypeBuiltins": "error",
        "noRedeclare": "error",
        "noSelfCompare": "error",
        "noShadowRestrictedNames": "error",
        "noSparseArray": "error",
        "noUnsafeDeclarationMerging": "error",
        "noUnsafeNegation": "error",
        "useAwait": "error",
        "useDefaultSwitchClauseLast": "error",
        "useGetterReturn": "error",
        "useNamespaceKeyword": "warn",
        "useValidTypeof": "error"
      },
      
      "complexity": {
        "noBannedTypes": "error",
        "noExtraBooleanCast": "error",
        "noForEach": "warn",
        "noMultipleSpacesInRegularExpressionLiterals": "error",
        "noStaticOnlyClass": "error",
        "noUselessConstructor": "error",
        "noUselessFragments": "error",
        "noUselessRename": "error",
        "noUselessSwitchCase": "error",
        "noUselessThisAlias": "error",
        "noUselessTypeConstraint": "error",
        "noVoid": "error",
        "noWith": "error",
        "useArrowFunction": "error",
        "useFlatMap": "warn",
        "useLiteralKeys": "error",
        "useOptionalChain": "error",
        "useRegexLiterals": "error",
        "useSimpleNumberKeys": "error",
        "useSimplifiedLogicExpression": "error"
      },
      
      "correctness": {
        "noChildrenProp": "error",
        "noConstEnum": "error",
        "noConstantMathMinMaxClamp": "error",
        "noEmptyPattern": "error",
        "noGlobalObjectCalls": "error",
        "noInvalidUseBeforeDeclaration": "error",
        "noPrecisionLoss": "error",
        "noSelfAssign": "error",
        "noSetterReturn": "error",
        "noStringCaseMismatch": "error",
        "noSwitchDeclarations": "error",
        "noUndeclaredVariables": "error",
        "noUnreachable": "error",
        "noUnreachableSuper": "error",
        "noUnsafeFinally": "error",
        "noUnusedLabels": "error",
        "noUnusedPrivateClassMembers": "error",
        "noUnusedVariables": "error",
        "useArrayLiterals": "error",
        "useExhaustiveDependencies": "error",
        "useHookAtTopLevel": "error",
        "useValidForDirection": "error",
        "useYield": "error"
      },
      
      "style": {
        "noArguments": "error",
        "noCommaOperator": "error",
        "noImplicitBoolean": "error",
        "noInferrableTypes": "off",
        "noNamespace": "error",
        "noNegationElse": "error",
        "noParameterAssign": "error",
        "noParameterProperties": "error",
        "noShoutyConstants": "warn",
        "noTemplateCurlyInString": "error",
        "noUnusedTemplateLiteral": "error",
        "noUselessElse": "error",
        "useCollapsedElseIf": "error",
        "useConst": "error",
        "useDefaultParameterLast": "error",
        "useEnumInitializers": "error",
        "useExponentiationOperator": "error",
        "useExportType": "off",
        "useFragmentSyntax": "error",
        "useImportType": "off",
        "useLiteralEnumMembers": "error",
        "useNamingConvention": "error",
        "useNodejsImportProtocol": "error",
        "useNumberNamespace": "error",
        "useSelfClosingElements": "error",
        "useShorthandArrayType": "error",
        "useShorthandAssign": "error",
        "useSingleCaseStatement": "error",
        "useSingleVarDeclarator": "error",
        "useTemplate": "error",
        "useThrowNewError": "error",
        "useWhile": "error"
      },
      
      "performance": {
        "noAccumulatingSpread": "error",
        "noDelete": "error"
      },
      
      "security": {
        "noDangerouslySetInnerHtml": "warn",
        "noGlobalEval": "error"
      }
    }
  },

  "formatter": {
    "enabled": true,
    "formatWithErrors": false,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100,
    "lineEnding": "lf",
    "attributePosition": "multiline"
  },

  "javascript": {
    "formatter": {
      "arrowParentheses": "always",
      "bracketSameLine": false,
      "bracketSpacing": true,
      "jsxQuoteStyle": "double",
      "quoteProperties": "asNeeded",
      "quoteStyle": "single",
      "semicolons": "always",
      "trailingCommas": "es5",
      "attributePosition": "multiline"
    }
  },

  "json": {
    "formatter": {
      "trailingCommas": "none"
    },
    "parser": {
      "allowComments": true,
      "allowTrailingCommas": true
    }
  },

  "overrides": [
    {
      "include": ["**/*.ts", "**/*.tsx", "**/*.d.ts"],
      "linter": {
        "rules": {
          "suspicious": {
            "noExplicitAny": "warn"
          },
          "style": {
            "useImportType": "warn",
            "useExportType": "warn",
            "noInferrableTypes": "warn"
          }
        }
      }
    },
    {
      "include": ["**/*.js", "**/*.jsx"],
      "linter": {
        "rules": {
          "suspicious": {
            "noExplicitAny": "off"
          },
          "style": {
            "useImportType": "off",
            "useExportType": "off"
          }
        }
      }
    },
    {
      "include": ["**/tests/**", "**/__tests__/**", "**/*.test.ts", "**/*.spec.ts"],
      "linter": {
        "rules": {
          "suspicious": {
            "noExplicitAny": "off",
            "noConsoleLog": "off",
            "noNonNullAssertion": "off"
          },
          "correctness": {
            "noUndeclaredVariables": "off"
          },
          "style": {
            "noParameterProperties": "off"
          }
        }
      }
    },
    {
      "include": ["**/scripts/**", "**/tools/**", "**/migrations/**"],
      "linter": {
        "rules": {
          "suspicious": {
            "noConsoleLog": "off",
            "noDebugger": "off",
            "noExplicitAny": "off"
          },
          "complexity": {
            "noUselessConstructor": "off"
          },
          "correctness": {
            "noUndeclaredVariables": "off"
          },
          "style": {
            "useNodejsImportProtocol": "off",
            "useImportType": "off",
            "useExportType": "off"
          }
        }
      }
    },
    {
      "include": ["**/types/**", "**/*.d.ts", "**/interfaces/**"],
      "linter": {
        "rules": {
          "style": {
            "useImportType": "off",
            "useExportType": "off"
          },
          "suspicious": {
            "noExplicitAny": "off"
          }
        }
      }
    },
    {
      "include": ["**/components/**", "**/pages/**", "**/layouts/**"],
      "linter": {
        "rules": {
          "correctness": {
            "useExhaustiveDependencies": "error"
          },
          "suspicious": {
            "noExplicitAny": "warn"
          }
        }
      }
    },
    {
      "include": ["**/api/**", "**/services/**", "**/lib/**"],
      "linter": {
        "rules": {
          "style": {
            "useNamingConvention": {
              "level": "warn",
              "options": {
                "conventions": [
                  {
                    "selector": "function",
                    "format": ["camelCase", "PascalCase"]
                  },
                  {
                    "selector": "variable",
                    "format": ["camelCase", "UPPER_CASE"]
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "include": ["**/*.json"],
      "json": {
        "parser": {
          "allowComments": false,
          "allowTrailingCommas": false
        }
      }
    }
  ],

  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true,
    "defaultBranch": "main"
  },

  "files": {
    "ignoreUnknown": false,
    "ignore": [
      "**/node_modules/**",
      "**/dist/**",
      "**/build/**",
      "**/.next/**",
      "**/out/**",
      "**/coverage/**",
      "**/.turbo/**",
      "**/.cache/**",
      "**/.vercel/**",
      "**/.netlify/**",
      "**/storybook-static/**",
      "**/public/**",
      "**/*.min.js",
      "**/*.bundle.js",
      "**/*.generated.*",
      "**/generated/**"
    ],
    "maxSize": 1024000
  },

  "assists": {
    "enabled": true,
    "actions": {
      "addMissingImports": "on",
      "organizeImports": "on",
      "removeUnusedImports": "on"
    }
  }
}