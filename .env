# RestPoint Docker Deployment Configuration

# ============================================
# ENVIRONMENT
# ============================================
NODE_ENV=production
APP_ENV=production

# ============================================
# DATABASE (MariaDB)
# ============================================
# Local run: connect to local MariaDB on 127.0.0.1 (container hostname
# restpoint_mariadb only resolves inside the Docker network).
# Docker deployments are unaffected: docker-compose.yml / docker-compose.prod.yml
# hardcode DB_HOST=restpoint_mariadb for the containers.
# DB_HOST=restpoint_mariadb
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=restpoint_main
DB_USER=restpoint_user
DB_PASSWORD=RestPointUser2024
DB_ROOT_PASSWORD=RestPointRoot2024
DB_ROOT_USER=root
VMC  =   w2Vl1y3T
# Required by docker-compose.yml MariaDB container
MARIADB_ROOT_PASSWORD=RestPointRoot2024
MARIADB_PASSWORD=RestPointUser2024

# ============================================
# CACHE (Redis) - Local Docker container
# ============================================
REDIS_HOST=restpoint_redis
REDIS_PORT=6379
REDIS_PASSWORD=redis123

# ============================================
# MESSAGE QUEUE (RabbitMQ) - Local Docker container
# ============================================
RABBITMQ_HOST=restpoint_rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_USER=restpoint
RABBITMQ_PASSWORD=RestPointRabbit2024
# Required by docker-compose.yml RabbitMQ container
RABBITMQ_DEFAULT_USER=restpoint
RABBITMQ_DEFAULT_PASS=RestPointRabbit2024

# ============================================
# AUTHENTICATION & SECURITY
# ============================================
JWT_SECRET=RestPointJWTSecret2024ChangeMe!SuperSecureInProduction
JWT_EXPIRY=24h
REFRESH_TOKEN_SECRET=RestPointJWTSecret2024ChangeMe!SuperSecureInProduction
REFRESH_TOKEN_EXPIRY=7d

# Internal service-to-service authentication
INTERNAL_SERVICE_SECRET=RestPointInternalSecret2024


# API GATEWAY CONFIGURATION

API_GATEWAY_URL=http://api-gateway:5000

# CORS Configuration - comma-separated list of allowed origins

ALLOWED_ORIGINS=https://restpoint.co.ke,https://www.restpoint.co.ke,https://app.restpoint.co.ke,http://localhost:5173,http://localhost:3000,http://localhost:5174,http://localhost:8080


# DEFAULT ADMIN CREDENTIALS

DEFAULT_ADMIN_EMAIL=infowelttallis@gmail.com
DEFAULT_ADMIN_PASSWORD=Admin@RestPoint2024


# M-PESA CONFIGURATION

MPESA_ENVIRONMENT=sandbox
MPESA_CONSUMER_KEY=your_consumer_key_here
MPESA_CONSUMER_SECRET=your_consumer_secret_here
MPESA_PASSKEY=your_mpesa_passkey_here
MPESA_SHORTCODE=your_shortcode_here


# EMAIL/SMTP CONFIGURATION

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password_here
SMTP_FROM=noreply@restpoint.local
SMTP_SECURE=false


# LOGGING & MONITORING

LOG_LEVEL=info
LOG_FORMAT=json


# FRONTEND CONFIGURATION

REACT_APP_API_BASE_URL=http://localhost:5000/api/v1
REACT_APP_SOCKETIO_URL=http://localhost:5013
REACT_APP_ENV=production


# EXTERNAL SERVICE PORTS (External)

API_GATEWAY_EXTERNAL_PORT=5000
AUTH_SERVICE_EXTERNAL_PORT=5001
TENANT_SERVICE_EXTERNAL_PORT=5002
DECEASED_SERVICE_EXTERNAL_PORT=5003
MARKETPLACE_SERVICE_EXTERNAL_PORT=5004
INVOICE_SERVICE_EXTERNAL_PORT=5005
COFFIN_SERVICE_EXTERNAL_PORT=5006
DOCUMENTS_SERVICE_EXTERNAL_PORT=5007
EDOCUMENTS_SERVICE_EXTERNAL_PORT=8116
ANALYTICS_SERVICE_EXTERNAL_PORT=5009
CALENDAR_SERVICE_EXTERNAL_PORT=5010
MPESA_SERVICE_EXTERNAL_PORT=5011
NOTIFICATION_SERVICE_EXTERNAL_PORT=5111
QRCODE_SERVICE_EXTERNAL_PORT=5012
SOCKETIO_SERVICE_EXTERNAL_PORT=5013
VISITORS_SERVICE_EXTERNAL_PORT=5014
BODYCHECKOUT_SERVICE_EXTERNAL_PORT=5015
EXTRA_SERVICES_EXTERNAL_PORT=5016
UPDATES_SERVICE_EXTERNAL_PORT=5017
CALL_SERVICE_EXTERNAL_PORT=5018
PORTAL_SERVICE_EXTERNAL_PORT=5019
BILLING_SERVICE_EXTERNAL_PORT=5020
CHEMICAL_SERVICE_EXTERNAL_PORT=5105
STORE_SERVICE_PORT=7071
STORE_SERVICE_EXTERNAL_PORT=7071
STORE_SERVICE_URL=http://restpoint_store_service:5000
EMBALMING_SERVICE_EXTERNAL_PORT=5105
WORKSHOP_SERVICE_EXTERNAL_PORT=6969

# ============================================
# FILE UPLOADS - Centralized storage for all services
# ============================================
UPLOADS_BASE_DIR=/opt/storage/uploads
GLOBAL_UPLOADS_DIR=/opt/storage/uploads

# ============================================
# OPERATIONS DATABASE - ONE central shared database for ALL tenants
# All operational modules share this single database:
#   coffins, hearses, florists, workshops, chemicals, extra-charges, leave
# Tenant isolation is enforced via tenant_slug column inside each table.
# Each operational service runs its own knex migrations independently against
# this SAME database (coffin, hearse, florist, workshop, chemical, etc.).
# Operational tables are NOT created in per-tenant/main databases.
# Main database per tenant keeps: deceased, branches, settings, users,
# invoices, payments, body_checkout, daily_billing, etc.
# ============================================
OPERATIONS_DATABASE=restpoint_operations
COFFIN_DATABASE=${OPERATIONS_DATABASE}  # legacy alias — both resolve to the same operations DB
COFFIN_SERVICE_PORT=5008

# Database/Message Queue Ports
MARIADB_EXTERNAL_PORT=3306
REDIS_EXTERNAL_PORT=6379
RABBITMQ_EXTERNAL_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672
FRONTEND_EXTERNAL_PORT=8080
FLORIST_PORT=7070
