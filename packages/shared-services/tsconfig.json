{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "outDir": "./dist",
    "rootDir": "./src",
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "composite": false,
    "incremental": false,
    "strict": false,
    "noImplicitAny": false,
    "strictNullChecks": false
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist", "../../services", "../../shared", "../../packages/shared-utils", "../../packages/shared-config", "../../packages/shared-logger", "../../packages/shared-metrics", "../../packages/shared-stamps"]
}
