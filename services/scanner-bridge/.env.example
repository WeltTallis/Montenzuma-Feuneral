# ═══════════════════════════════════════════════════════════════════════════
#  Restpoint Scanner Bridge — environment
#  Ship ONLY the compiled executable: dist/agent.js  (config via env vars)
# ═══════════════════════════════════════════════════════════════════════════

# ── Network ────────────────────────────────────────────────────────────────
BRIDGE_HOST=0.0.0.0
BRIDGE_PORT=8081

# Comma-separated list of browser origins allowed to connect
# (empty = allow all). Example: https://restpoint.co.ke,http://localhost:5173
BRIDGE_ALLOWED_ORIGINS=

# Allow the SHUTDOWN control message (used by tests — leave 0 in production)
BRIDGE_ALLOW_SHUTDOWN=0

# ── Scanner (real hardware) ─────────────────────────────────────────────────
# NAPS2 CLI (https://github.com/nathaniel-mahieu/NAPS2) talks to the
# scanner over TWAIN/WIA/eSCL. Install it, then set the path if needed.
# A FOLDER works too — the bridge finds NAPS2.Console.exe inside it — and when
# this is left unset the usual install folders are auto-discovered.
NAPS2_PATH=C:\Program Files\NAPS2

# Preferred scanner name — set to your HP ScanJet model if auto-detect fails.
# List devices with:  NAPS2.Console.exe --driver wia --listdevices
# (NAPS2 8.x has no `naps2 list` verb; --listdevices needs an explicit driver.)
SCANNER_NAME=HP ScanJet Pro 2600 f1

# Scanning driver: wia | twain | escl (Windows). Leave empty on macOS/Linux.
# NAPS2 8.x requires this before --device/--listdevices may be used.
SCANNER_DRIVER=wia

# Paper source: glass | feeder | duplex (empty = NAPS2 default / SCANNER_DUPLEX)
SCANNER_SOURCE=duplex

# Drivers probed by GET_SCANNERS. escl performs network discovery and can be
# slow, so it is opt-in only.
SCANNER_DRIVERS=wia,twain

# Optional named NAPS2 profile (GUI profile). When empty the bridge passes
# --noprofile so the flags in this file always win.
SCANNER_PROFILE=

SCANNER_DEFAULT_FORMAT=pdf
SCANNER_DEFAULT_DPI=300
SCANNER_DEFAULT_COLOR_MODE=color
SCANNER_DUPLEX=1
SCANNER_AUTO_DETECT=true

# Full override: a command template. Tokens:
#   {NAPS2} {OUTPUT} {FORMAT} {RESOLUTION} {MODE} {DUPLEX} {SOURCE} {SCANNER} {DRIVER}
# NAPS2 6.x-8.x has no "scan" verb — e.g.
#   SCAN_COMMAND={NAPS2} -o "{OUTPUT}" --dpi {RESOLUTION} {MODE} {DUPLEX} {DRIVER} {SCANNER}
# Leave empty to use the built-in NAPS2 command.
SCAN_COMMAND=

# Extra CLI flags appended to the default NAPS2 command, e.g. --crop auto
SCAN_COMMAND_EXTRA=

# pipe (capture output) | inherit (show driver output in the console)
SCANNER_STDIO=pipe

# Timeout for the scanning process in ms
SCAN_TIMEOUT_MS=120000

# Work directory for scanned PDFs before they are uploaded & then deleted
# SCANNER_WORK_DIR=C:\Users\receptionist\AppData\Local\Temp\restpoint-scanner-bridge

# ── Mock mode (no hardware — for testing/demo) ─────────────────────────────
# MOCK_SCAN=1