{
  "name": "@montezuma/documents-service",
  "version": "1.0.0",
  "description": "Montezuma Mortuary SaaS documents-service",
  "main": "../../dist/services/documents-service/server.js",
  "scripts": {
    "start": "node ../../dist/services/documents-service/server.js",
