# syntax=docker/dockerfile:1
# ===========================================================================
# RestPoint store-service — multi-stage production image
# Generated by scripts/generate-dockerfiles.mjs — DO NOT EDIT BY HAND.
# Regenerate:  node scripts/generate-dockerfiles.mjs
#
# Why 4 stages: the legacy single-stage image shipped build tools (python3/
# make/g++), ALL devDependencies (typescript, nodemon, …), a global tsx, and a
# `chown -R nodejs:nodejs /usr/src/app` layer that duplicated the whole app
# (+504MB). This build only ships production node_modules + built shared
# package dists + runtime sources.
# Source uses .ts import specifiers (ESM+TS) → runs via tsx from source.
# ===========================================================================

# Self-contained service: NOT part of the root workspace install. It installs
# only its own package.json (no shared packages).

# ---------------------------------------------------------------------------
# Stage 1/3 — deps: full tree for any build tooling
# ---------------------------------------------------------------------------
FROM node:24-alpine AS deps
WORKDIR /usr/src/app/services/store-service
ENV NODE_OPTIONS=--max-old-space-size=2048
COPY services/store-service/package.json ./

RUN npm config set fetch-timeout 1200000 \
 && npm config set fetch-retries 5 \
 && npm config set fetch-retry-mintimeout 120000 \
 && npm config set fetch-retry-maxtimeout 600000 && npm install --legacy-peer-deps --no-audit --no-fund

# ---------------------------------------------------------------------------
# Stage 2/3 — prod-deps: production-only node_modules
# ---------------------------------------------------------------------------
FROM node:24-alpine AS prod-deps
WORKDIR /usr/src/app/services/store-service
ENV NODE_OPTIONS=--max-old-space-size=2048
COPY services/store-service/package.json ./

RUN npm config set fetch-timeout 1200000 \
 && npm config set fetch-retries 5 \
 && npm config set fetch-retry-mintimeout 120000 \
 && npm config set fetch-retry-maxtimeout 600000 && npm install --omit=dev --legacy-peer-deps --no-audit --no-fund

# ---------------------------------------------------------------------------
# Stage 3/3 — runtime
# ---------------------------------------------------------------------------
FROM node:24-alpine AS runtime

RUN apk add --no-cache dumb-init wget \
 && addgroup -g 1001 -S nodejs \
 && adduser -S nodejs -u 1001

# tsx runs the TS entry from source (.ts import specifiers — see note above)
RUN npm install -g tsx --no-audit --no-fund

WORKDIR /usr/src/app/services/store-service

COPY --from=prod-deps --chown=nodejs:nodejs /usr/src/app/services/store-service/node_modules ./node_modules
COPY --chown=nodejs:nodejs services/store-service/ ./

# routes/storeRoutes.ts imports the shared CommonJS auth middleware via
# '../../../services/app-global/middlewares/authMiddleware.js', which resolves
# to /usr/src/app/services/app-global — exactly like every other service image,
# so it must be present in the runtime layer or boot fails with
# ERR_MODULE_NOT_FOUND. (authMiddleware needs jsonwebtoken, which is declared
# in this service's dependencies for the same reason.)
COPY --chown=nodejs:nodejs services/app-global/ /usr/src/app/services/app-global/

USER nodejs

EXPOSE 5000
ENV NODE_ENV=production
ENV PORT=5000

HEALTHCHECK --interval=30s --timeout=3s --start-period=15s --retries=3 \
  CMD node -e "fetch('http://localhost:5000/health').then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))" || exit 1

ENTRYPOINT ["dumb-init", "--"]
CMD ["tsx","server.ts"]
