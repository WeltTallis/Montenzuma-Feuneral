{
  "name": "@montezuma/coffin-service",
  "version": "1.0.0",
  "description": "Montezuma Mortuary SaaS coffin-service",
  "main": "dist/services/coffin-service/server.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/services/coffin-service/server.js",
    "dev": "nodemon --watch src --ext ts,json --exec \"npm run build && node dist/services/coffin-service/server.js\"",
    "typecheck": "tsc --noEmit",
    "migrate": "node migrate-coffin-db.js",
    "migrate:latest": "node migrate-coffin-db.js",
    "db:create": "node -e \"require('./db').ensureCoffinDatabase().then(()=>console.log('ok')).catch(e=>{console.error(e);process.exit(1)})\""
  },
  "dependencies": {
    "@montezuma/shared-config": "^1.0.0",
    "@montezuma/shared-logger": "^1.0.0",
    "@montezuma/shared-services": "^1.0.0",
    "@montezuma/shared-utils": "^1.0.0",
    "bcrypt": "^6.0.0",
    "bull": "4.16.5",
    "bullmq": "^5.61.2",
    "cors": "^2.8.5",
    "csurf": "^1.11.0",
    "dotenv": "^17.2.0",
    "exceljs": "3.10.0",
    "express": "^5.1.0",
    "generic-pool": "^3.9.0",
    "helmet": "^8.1.0",
    "http-proxy-middleware": "3.0.7",
    "ioredis": "^5.8.2",
    "jsonwebtoken": "^9.0.2",
    "knex": "^3.3.0",
    "multer": "^2.2.0",
    "mysql2": "3.23.3",
    "object-assign": "^4.1.1",
    "sharp": "^0.35.3"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/multer": "^1.4.7",
    "@types/node": "^22.13.10",
    "nodemon": "^3.1.10",
    "rimraf": "^6.0.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.8.2"
  }
}
