# coffin-service Configuration
NODE_ENV=production
PORT=5008
SERVICE_NAME=coffin-service
INTERNAL_SERVICE_SECRET=RestPointInternalSecret2024

# Database
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=restpoint_main
DB_USER=restpoint_user
DB_PASSWORD=RestPointUser2024

# Coffin Service - CENTRAL (shared) coffin database for ALL tenants.
# The coffin service runs its own knex migrations independently against this DB.
# (Host/port/user/password fall back to the shared DB_* vars above; only the
#  database name is different, so no need to expand them here.)
COFFIN_DATABASE=restpoint_coffin

# Redis Cache
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
# REDIS_PASSWORD=RestPointRedis2024

# JWT/Security
JWT_SECRET=RestPointJWTSecret2024ChangeMe!SuperSecureInProduction

COFFIN_SERVICE_URL=http://coffin-service:5008


