# coffin-service Configuration
NODE_ENV=production
# 5006 = docker-compose host port (docker-compose.yml maps 5006:5000).
# Was 5008, which clashed with invoice-service's local port.
PORT=5006
SERVICE_NAME=coffin-service
INTERNAL_SERVICE_SECRET=RestPointInternalSecret2024

# Database
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=restpoint_main
DB_USER=restpoint_user
DB_PASSWORD=RestPointUser2024
# Shared central operations database for ALL tenants.
# Operational services (coffins, hearses, florists, workshop, chemicals, extras, leave)
# all run their own knex migrations against this ONE shared database.
# Tenant isolation is via tenant_slug column in each table.
OPERATIONS_DATABASE=restpoint_operations

# Redis Cache
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
# REDIS_PASSWORD=RestPointRedis2024

# JWT/Security
JWT_SECRET=RestPointJWTSecret2024ChangeMe!SuperSecureInProduction

COFFIN_SERVICE_URL=http://127.0.0.1:5006


