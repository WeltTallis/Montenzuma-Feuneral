    "hpp": "^0.2.3",
    "jsonwebtoken": "^9.0.2",
    "redis": "^4.7.1",
    "socket.io": "^4.7.2"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/express-rate-limit": "^6.0.0",
    "@types/helmet": "^4.0.0",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/node": "^20.10.0",
    "nodemon": "^3.0.1",
