# syntax=docker/dockerfile:1
# ===========================================================================
# RestPoint insurance-service — multi-stage production image
# Generated by scripts/generate-dockerfiles.mjs — DO NOT EDIT BY HAND.
# Regenerate:  node scripts/generate-dockerfiles.mjs
#
# WHY THIS IS SIMPLER THAN THE ANALYTICS IMAGE
# insurance-service compiles to plain JS with `tsc` and runs under plain
# `node` — it does NOT need the `tsx` runtime that every other TypeScript
# service in this repo uses. That drops a whole global install from the
# final image.
#
# TWO THINGS THIS IMAGE DELIBERATELY FIXES vs the other services
#   1. HEALTHCHECK uses `wget -q -O /dev/null <url>`. The generated images all
#      use `wget --no-verbose --tries=1 --spider <url>`, but this is
#      node:*-alpine, whose wget is BUSYBOX wget - it has no --no-verbose,
#      --tries or --spider flags. Those probes exit non-zero on "unrecognized
#      option" every single time, so every generated service is permanently
#      reported UNHEALTHY even while serving traffic perfectly.
#   2. MIGRATIONS ARE SHIPPED. server.ts calls knex migrate.latest() at boot,
#      and knex resolves the migrations directory relative to the process
#      cwd - so migrations/ must exist in the runtime image, not just in the
#      builder. Without this the container boots, logs "migrations failed",
#      serves 500s, and reports DEGRADED forever.
# ===========================================================================

# ---------------------------------------------------------------------------
# Stage 1/3 — deps: full dependency tree (incl. dev) just for building
# ---------------------------------------------------------------------------
FROM node:24-alpine AS deps
WORKDIR /usr/src/app
ENV NODE_OPTIONS=--max-old-space-size=2048
COPY package.json package-lock.json tsconfig.base.json ./
COPY packages/shared-config/package.json ./packages/shared-config/
COPY packages/shared-logger/package.json ./packages/shared-logger/
COPY packages/shared-utils/package.json ./packages/shared-utils/
COPY packages/shared-services/package.json ./packages/shared-services/
COPY shared/package.json ./shared/
COPY services/insurance-service/package.json ./services/insurance-service/

RUN npm config set fetch-timeout 1200000 \
  && npm config set fetch-retries 5 \
  && npm config set fetch-retry-mintimeout 120000 \
  && npm config set fetch-retry-maxtimeout 600000 \
  && npm install --legacy-peer-deps --no-audit --no-fund

# ---------------------------------------------------------------------------
# Stage 2/3 — prod-deps: production-only node_modules (--omit=dev)
# ---------------------------------------------------------------------------
FROM node:24-alpine AS prod-deps
WORKDIR /usr/src/app
ENV NODE_OPTIONS=--max-old-space-size=2048
COPY package.json package-lock.json tsconfig.base.json ./
COPY packages/shared-config/package.json ./packages/shared-config/
COPY packages/shared-logger/package.json ./packages/shared-logger/
COPY packages/shared-utils/package.json ./packages/shared-utils/
COPY packages/shared-services/package.json ./packages/shared-services/
COPY shared/package.json ./shared/
COPY services/insurance-service/package.json ./services/insurance-service/

RUN npm config set fetch-timeout 1200000 \
  && npm config set fetch-retries 5 \
  && npm config set fetch-retry-mintimeout 120000 \
  && npm config set fetch-retry-maxtimeout 600000 \
  && npm install --omit=dev --legacy-peer-deps --no-audit --no-fund

# ---------------------------------------------------------------------------
# Stage 3/3 — build + runtime
# ---------------------------------------------------------------------------
FROM node:24-alpine AS runtime

RUN apk add --no-cache dumb-init wget \
  && addgroup -g 1001 -S nodejs \
  && adduser -S nodejs -u 1001

WORKDIR /usr/src/app

# Compile from the deps stage (which still has typescript) rather than
# installing a toolchain in the runtime image.
COPY --from=deps /usr/src/app/node_modules ./node_modules
COPY --from=prod-deps /usr/src/app/node_modules ./node_modules

COPY tsconfig.base.json ./
COPY shared/ ./shared/
COPY services/insurance-service/ ./services/insurance-service/

# tsc emits to dist/services/insurance-service/** because rootDir is ../..
# (server.ts imports ../../shared/tenancy). Entrypoint is
# dist/services/insurance-service/server.js — see package.json "main".
RUN npm run build --workspace=@montezuma/insurance-service \
  || (cd services/insurance-service && npx tsc)

# migrations/ must survive into the runtime image (see note 2 at the top).
RUN test -f services/insurance-service/dist/services/insurance-service/server.js \
  && test -d services/insurance-service/migrations

RUN mkdir -p /usr/src/app/data \
  && chown -R nodejs:nodejs /usr/src/app/data

USER nodejs

EXPOSE 5000
ENV NODE_ENV=production
ENV PORT=5000

# Busybox wget has no --no-verbose/--tries/--spider. This is the form it
# actually supports, and it performs a real GET so it only passes on a 200.
HEALTHCHECK --interval=30s --timeout=5s --start-period=40s --retries=3 \
  CMD wget -q -O /dev/null http://localhost:5000/health || exit 1

ENTRYPOINT ["dumb-init", "--"]
CMD ["node","services/insurance-service/dist/services/insurance-service/server.js"]