{
  "name": "@montezuma/insurance-service",
  "version": "1.0.0",
  "description": "Amani Cover insurance - policies, group members and claims (policy number == policy holder's national ID number)",
  "main": "dist/services/insurance-service/server.js",
  "_comment_outDir": "rootDir is ../.. because server.ts imports shared/tenancy.js, so tsc emits services/insurance-service/** and shared/** under dist/. The entrypoint is therefore dist/services/insurance-service/server.js, not dist/server.js.",
  "scripts": {
    "start": "node dist/services/insurance-service/server.js",
    "dev": "nodemon --watch . --ext ts --exec \"npx ts-node server.ts\"",
    "build": "tsc",
    "build:watch": "tsc --watch",
    "typecheck": "tsc --noEmit",
    "lint": "echo 'Insurance lint OK'",
    "lint:fix": "echo 'Insurance lint fix OK'",
    "test": "npx ts-node scripts/smoke-test.ts",
    "migrate": "knex --knexfile knexfile.js migrate:latest",
    "migrate:rollback": "knex --knexfile knexfile.js migrate:rollback",
    "migrate:status": "knex --knexfile knexfile.js migrate:status",
    "clean": "rimraf dist"
  },
  "nodemonConfig": {
    "watch": [
      "server.ts",
      "db.ts",
      "controllers",
      "routes",
      "models"
    ],
    "ext": "ts",
    "ignore": [
      "dist/*",
      "node_modules/*"
    ],
    "execMap": {
      "ts": "npx ts-node"
    },
    "delay": 1000,
    "verbose": true
  },
  "dependencies": {
    "@montezuma/shared-config": "^1.0.0",
    "@montezuma/shared-logger": "^1.0.0",
    "@montezuma/shared-services": "^1.0.0",
    "cors": "^2.8.5",
    "dotenv": "^17.2.0",
    "express": "^4.18.2",
    "helmet": "^8.1.0",
    "knex": "^3.1.0",
    "morgan": "^1.10.0",
    "multer": "2.2.0",
    "mysql2": "3.23.3"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/morgan": "^1.9.10",
    "@types/node": "^22.13.10",
    "nodemon": "^3.1.10",
    "rimraf": "^6.0.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3"
  },
  "author": "Peter Mumo",
  "license": "ISC"
}