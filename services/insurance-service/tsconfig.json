{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "outDir": "./dist",
    "rootDir": "../..",
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,

    "strict": false,
    "noImplicitAny": false,
    "noUncheckedIndexedAccess": false,
    "skipLibCheck": true,
    "allowJs": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "types": [
      "node"
    ]
  },

  "_comment_include": [
    "Only the ONE shared module this service imports is listed.",
    "A broad '../../shared/**/*' glob drags in shared/fileStorageService and",
    "shared/centralizedUploadService, which import from packages/shared-services",
    "(a composite project this tsconfig does not list) and tsc then fails with",
    "TS6307 on files insurance never touches."
  ],

  "include": [
    "server.ts",
    "db.ts",
    "routes/**/*.ts",
    "controllers/**/*.ts",
    "models/**/*.ts",
    "knexfile.js",
    "../../shared/tenancy.js"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "migrations",
    "**/*.spec.ts",
    "**/*.test.ts"
  ]
}