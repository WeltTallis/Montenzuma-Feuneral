# KRA eTims API Configuration
NODE_ENV=development # Options: development, production

# API Base URLs
DEV_API_BASE_URL=https://etims-api-sbx.kra.go.ke
PROD_API_BASE_URL=https://etims-api.kra.go.ke/etims-api

# Authentication
API_USERNAME=your_username
API_PASSWORD=your_password

# Queued OSCU/VSCU sales worker; use secrets from a trusted secret manager in production.
ETIMS_MODE=oscu
ETIMS_BASE_URL=https://etims-api-sbx.kra.go.ke/etims-api/
ETIMS_TIN=P000000000X
ETIMS_BHF_ID=00
ETIMS_USERNAME=your_etims_username
ETIMS_PASSWORD=your_etims_password
ETIMS_COMMUNICATION_KEY=your_communication_key
ETIMS_ALLOW_INSECURE_VSCU=false
ETIMS_QUEUE_WAIT_TIMEOUT_MS=120000

# Redis is required by the sales queue and worker.
REDIS_URL=redis://localhost:6379

# Server
PORT=5000

# Domains Whitelisting(for CORS)
# Comma-separated list of allowed origins (no spaces)
# Use '*' only when the service is intentionally public.
CORS_ALLOWED_ORIGINS=http://eurochess.net,http://fintech.co.ke,http://localhost:3000
