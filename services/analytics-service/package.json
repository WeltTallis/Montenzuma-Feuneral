{
  "name": "@montezuma/analytics-service",
  "version": "1.0.0",
  "description": "Montezuma Mortuary SaaS analytics-service",
  "main": "dist/server.js",
  "scripts": {
    "start": "node dist/server.js",
    "dev": "nodemon --watch . --ext ts --exec \"npx ts-node server.ts\"",
    "dev:js": "nodemon server.js",
    "worker": "npx ts-node workers-analyticsWorker.ts",
    "worker:js": "node workers-analyticsWorker.js",
    "build": "tsc",
    "build:watch": "tsc --watch",
    "typecheck": "tsc --noEmit",
    "lint": "echo 'Analytics lint OK'",
    "lint:fix": "echo 'Analytics lint fix OK'",
    "test": "npx ts-node test-analytics.ts",
    "clean": "rimraf dist"
  },
  "nodemonConfig": {
    "watch": [
      "."
    ],
    "ext": "ts",
    "ignore": [
      "dist/*",
      "node_modules/*",
      "*.test.ts",
      "*.spec.ts"
    ],
    "execMap": {
      "ts": "npx ts-node"
    },
    "env": {
      "NODE_ENV": "development",
      "NODE_OPTIONS": "--max-old-space-size=4096"
    },
    "delay": 1000,
    "verbose": true
  },
  "dependencies": {
    "@montezuma/shared-config": "^1.0.0",
    "@montezuma/shared-logger": "^1.0.0",
    "@montezuma/shared-services": "^1.0.0",
    "bullmq": "^5.61.2",
    "cors": "^2.8.5",
    "dotenv": "^17.2.0",
    "exceljs": "3.10.0",
    "express": "^5.1.0",
    "express-async-handler": "^1.2.0",
    "helmet": "^8.1.0",
    "http-proxy-middleware": "3.0.7",
    "ioredis": "^5.8.2",
    "jsonwebtoken": "^9.0.2",
    "multer": "2.2.0",
    "mysql2": "3.23.3",
    "pdfkit": "^0.13.0",
    "prom-client": "^15.1.3",
    "sharp": "0.35.3",
    "socket.io": "^4.8.0",
    "winston": "^3.18.3"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/helmet": "^0.0.48",
    "@types/ioredis": "^4.28.10",
    "@types/node": "^22.13.10",
    "@types/pdfkit": "^0.17.6",
    "nodemon": "^3.1.10",
    "rimraf": "^6.0.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3"
  },
  "author": "Peter Mumo",
  "license": "ISC"
}
