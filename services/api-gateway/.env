i# api-gateway Configuration
NODE_ENV=production
PORT=5000
SERVICE_NAME=api-gateway
INTERNAL_SERVICE_SECRET=RestPointInternalSecret2024

# Database
# IMPORTANT: Use 127.0.0.1 instead of localhost to avoid MySQL socket authentication issues
DB_HOST=restpoint_mariadb
DB_PORT=3306
DB_NAME=restpoint_main
DB_USER=restpoint_user
DB_PASSWORD=RestPointUser2024

# Redis Cache
REDIS_HOST=restpoint_redis
REDIS_PORT=6379
# REDIS_PASSWORD=RestPointRedis2024

# RabbitMQ
RABBITMQ_HOST=restpoint_rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_USER=restpoint
RABBITMQ_PASSWORD=RestPointRabbit2024

# JWT/Security
JWT_SECRET=RestPointJWTSecret2024ChangeMe!SuperSecureInProduction

# Service-specific Configuration
RATE_LIMIT_WINDOW_MS=90000
RATE_LIMIT_MAX_REQUESTS=100000
SERVICE_TIMEOUT=30000

# CORS Configuration - comma-separated list of allowed origins
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost:5174,https://restpoint.co.ke,https://app.restpoint.co.ke

# Service Discovery (Docker DNS / local fallback)
AUTH_SERVICE_URL=http://restpoint_auth_service:5000
TENANT_SERVICE_URL=http://restpoint_tenant_service:5000
DECEASED_SERVICE_URL=http://restpoint_deceased_service:5000
MARKETPLACE_SERVICE_URL=http://restpoint_marketplace_service:5000
INVOICE_SERVICE_URL=http://restpoint_invoice_service:5000
COFFIN_SERVICE_URL=http://restpoint_coffin_service:5000
DOCUMENTS_SERVICE_URL=http://restpoint_documents_service:5000
EDOCUMENTS_SERVICE_URL=http://restpoint_edocuments_service:5000
ANALYTICS_SERVICE_URL=http://restpoint_analytics_service:5000
CALENDAR_SERVICE_URL=http://restpoint_calender_service:5000
MPESA_SERVICE_URL=http://restpoint_mpesa_service:5000
NOTIFICATION_SERVICE_URL=http://restpoint_notification_service:5000
SOCKETIO_SERVICE_URL=http://restpoint_socketio_service:5000
VISITORS_SERVICE_URL=http://restpoint_visitors_service:5000
BODYCHECKOUT_SERVICE_URL=http://restpoint_bodycheckout_service:5000
PORTAL_SERVICE_URL=http://restpoint_portal_service:5000
CHEMICALS_SERVICE_URL=http://restpoint_chemical_service:5000
BILLING_SERVICE_URL=http://restpoint_billing_service:5000
QRCODE_SERVICE_URL=http://restpoint_qrcode_service:5000
HEARSE_SERVICE_URL=http://restpoint_hearse_service:5000
SUPPORT_SERVICE_URL=http://restpoint_support_service:5000
FLORIST_SERVICE_URL=http://restpoint_florist_service:5000
STORE_SERVICE_URL=http://restpoint_store_service:5000
API_GATEWAY_URL=http://restpoint_api_gateway:5000
