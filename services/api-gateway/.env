# api-gateway Configuration
NODE_ENV=production
PORT=5000
SERVICE_NAME=api-gateway
INTERNAL_SERVICE_SECRET=RestPointInternalSecret2024

# Database
# IMPORTANT: Use 127.0.0.1 instead of localhost to avoid MySQL socket authentication issues
DB_HOST=restpoint_mariadb
DB_PORT=3306
DB_NAME=restpoint_main
DB_USER=restpoint_user
DB_PASSWORD=RestPointUser2024

# Redis Cache
REDIS_HOST=restpoint_redis
REDIS_PORT=6379
# REDIS_PASSWORD=RestPointRedis2024

# RabbitMQ
RABBITMQ_HOST=restpoint_rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_USER=restpoint
RABBITMQ_PASSWORD=RestPointRabbit2024

# JWT/Security
JWT_SECRET=RestPointJWTSecret2024ChangeMe!SuperSecureInProduction

# Service-specific Configuration
RATE_LIMIT_WINDOW_MS=90000
RATE_LIMIT_MAX_REQUESTS=100000
SERVICE_TIMEOUT=30000

# CORS Configuration - comma-separated list of allowed origins
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost:5174,https://restpoint.co.ke,https://app.restpoint.co.ke

# ─── Service Discovery ──────────────────────────────────────────────────────
# LOCAL (host / nodemon) MODE: each service runs directly on 127.0.0.1 using
# the same port docker-compose maps to the host (docker-compose.yml "ports:").
#
# In Docker deployments these values are OVERRIDDEN by the `environment:` block
# of docker-compose.yml / docker-compose.prod.yml — server.js loads this file
# with dotenv override:false, so compose-provided variables always win.
#
# restpoint_*_service Docker names only resolve INSIDE the Docker network.
# Running the gateway on the host with those names fails every lookup with
# ENOTFOUND, which is what marked all (working) services as DOWN and returned
# 503 "Now API Gateway is Down" for /api/v1/restpoint/* routes.

AUTH_SERVICE_URL=http://127.0.0.1:5001
TENANT_SERVICE_URL=http://127.0.0.1:5002
DECEASED_SERVICE_URL=http://127.0.0.1:5003
INVOICES_SERVICE_URL=http://127.0.0.1:5005
# legacy singular name kept: some services read INVOICE_SERVICE_URL
INVOICE_SERVICE_URL=http://127.0.0.1:5005
COFFIN_SERVICE_URL=http://127.0.0.1:5006
DOCUMENTS_SERVICE_URL=http://127.0.0.1:5007
ANALYTICS_SERVICE_URL=http://127.0.0.1:5009
SOCKETIO_SERVICE_URL=http://127.0.0.1:5018
BODYCHECKOUT_SERVICE_URL=http://127.0.0.1:5015
CHEMICALS_SERVICE_URL=http://127.0.0.1:5105
BILLING_SERVICE_URL=http://127.0.0.1:5020
WORKSHOP_SERVICE_URL=http://127.0.0.1:6969
EXTRA_SERVICES_URL=http://127.0.0.1:5016
HEARSE_SERVICE_URL=http://127.0.0.1:5023
SCANNER_SERVICE_URL=http://127.0.0.1:2024
SUPPORT_SERVICE_URL=http://127.0.0.1:8111
LEAVE_SERVICE_URL=http://127.0.0.1:5017
FLORIST_SERVICE_URL=http://127.0.0.1:7070
STORE_SERVICE_URL=http://127.0.0.1:7071

# Not deployed locally (no service folder in this repo / Docker only) — these
# will show as DOWN in /health on the host, which is expected:
MARKETPLACE_SERVICE_URL=http://restpoint_marketplace_service:5000
EDOCUMENTS_SERVICE_URL=http://restpoint_edocuments_service:5000
CALENDAR_SERVICE_URL=http://restpoint_calender_service:5000
MPESA_SERVICE_URL=http://restpoint_mpesa_service:5000
PORTAL_SERVICE_URL=http://restpoint_portal_service:5000
QRCODE_SERVICE_URL=http://restpoint_qrcode_service:5000
CALL_SERVICE_URL=http://restpoint_call_service:5000
NOTIFICATION_SERVICE_URL=http://restpoint_notification_service:5000
VISITORS_SERVICE_URL=http://restpoint_visitors_service:5000
API_GATEWAY_URL=http://restpoint_api_gateway:5000
