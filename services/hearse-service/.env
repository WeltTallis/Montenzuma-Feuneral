# Hearse Service Configuration
# Loads shared configuration from root .env file
# Uses the central operations database (restpoint_operations)
PORT=5023
SOCKET_CORS_ORIGIN=*
SERVICE_NAME=hearse-service
NODE_ENV=production
INTERNAL_SERVICE_SECRET=RestPointInternalSecret2024

# ============================================
# DATABASE - local MariaDB (local dev)
# This file is loaded BEFORE the repo-root .env, so these values win
# (dotenv does not override already-set variables).
# ============================================
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=restpoint_user
DB_PASSWORD=RestPointUser2024
OPERATIONS_DATABASE=restpoint_operations






GLOBAL_REFRESH_SECRET=RestPointRefreshSecret2024!SuperSecureInProduction
GLOBAL_JWT_SECRET=RestPointJWTSecret2024ChangeMe!SuperSecureInProduction
REFRESH_TOKEN_SECRET=RestPointRefreshSecret2024!SuperSecureInProduction
JWT_SECRET=RestPointJWTSecret2024ChangeMe!SuperSecureInProduction

