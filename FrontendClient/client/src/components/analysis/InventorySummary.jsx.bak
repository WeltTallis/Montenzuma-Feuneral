// src/components/analysis/InventorySummary.jsx
import React from "react";

const InventorySummary = () => {
  const coffins = [
    { name: "Oak Standard", reserved: 2, stock: 2, status: "danger" },
    { name: "Mahogany Deluxe", reserved: 3, stock: 8, status: "success" },
    { name: "Pine Economy", reserved: 6, stock: 15, status: "success" },
    { name: "Cedar Premium", reserved: 4, stock: 4, status: "warning" },
    { name: "Stainless Steel", reserved: 1, stock: 3, status: "success" },
  ];

  const flowers = [
    { id: "FL-201", name: "Casket Spray", caseId: "FN-2051", time: "09:45", status: "ready" },
    { id: "FL-202", name: "Standing Wreath", caseId: "FN-2050", time: "13:00", status: "preparing" },
    { id: "FL-203", name: "Casket Spray", caseId: "FN-2049", time: "—", status: "delayed" },
    { id: "FL-204", name: "Bouquet x3", caseId: "FN-2048", time: "08:00", status: "delivered" },
  ];

  return (
    <div className="inventory-summary">
      <div className="panel-header">
        <div className="panel-title">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="2.5">
            <path d="M11 21.73a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73zm1 .27V12"/>
            <path d="M3.29 7L12 12l8.71-5M7.5 4.27l9 5.15"/>
          </svg>
          <span>Inventory & Flowers</span>
        </div>
        <button className="view-all-link">Full inventory</button>
      </div>
      <div className="inventory-section">
        <div className="section-title">Coffins / Caskets</div>
        <div className="coffins-list">
          {coffins.map((coffin, idx) => (
            <div key={idx} className="coffin-item">
              <span className="coffin-name">{coffin.name}</span>
              <span className="coffin-reserved">Rsv: {coffin.reserved}</span>
              <span className={"coffin-stock " + coffin.status}>{coffin.stock}</span>
              {coffin.status === "danger" && (
                <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="2.5" className="stock-alert danger">
                  <circle cx="12" cy="12" r="10"/>
                  <path d="M12 8v4m0 4h.01"/>
                </svg>
              )}
              {coffin.status === "warning" && (
                <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="2.5" className="stock-alert warning">
                  <path d="m21.73 18l-8-14a2 2 0 0 0-3.48 0l-8 14A2 2 0 0 0 4 21h16a2 2 0 0 0 1.73-3M12 9v4m0 4h.01"/>
                </svg>
              )}
            </div>
          ))}
        </div>
      </div>
      <div className="inventory-section">
        <div className="section-title">Flower Orders — Today</div>
        <div className="flowers-list">
          {flowers.map((flower, idx) => (
            <div key={idx} className="flower-item">
              <span className="flower-id mono-font">{flower.id}</span>
              <span className="flower-name">{flower.name} · {flower.caseId}</span>
              <span className="flower-time">{flower.time}</span>
              <div className={"flower-status bg-" + flower.status + "-bg text-" + flower.status + " border-" + flower.status + "-border"}>
                {flower.status}
              </div>
            </div>
          ))}
        </div>
      </div>
    </div>
  );
};

export default InventorySummary;
