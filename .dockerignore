# Git
.git/
.gitignore
.gitattributes
.gitmodules

# Node
# Exclude node_modules at EVERY depth. `node_modules/` alone only excludes the
# context-root copy; without `**/node_modules` the per-service local dev trees
# (services/<svc>/node_modules — full of workspace symlinks like
# ../../../../node_modules/express-rate-limit) leak into the build context and
# get COPY'd into the runtime image, where the symlinks dangle and
# require() throws "Cannot find module" (this was the real cause of the
# api-gateway / auth-service boot failure). Exclude them so ONLY the prod-deps
# root node_modules (hoisted, deterministic) is used.
node_modules/
**/node_modules/
**/node_modules/**
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.yarn/
.pnpm/

# Build artifacts
dist/
build/
*.tsbuildinfo
**/dist/**
**/build/**

# Environment files
.env
.env.*
!.env.example
!.env.production

# IDE
.idea/
.vscode/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# Docker
.dockerignore
docker-compose*.yml
Dockerfile*
**/Dockerfile*

# Logs
logs/
*.log

# Test
coverage/
.nyc_output/
__tests__/
__mocks__/
**/*.test.*
**/*.spec.*

# Documentation
docs/
*.md
!README.md