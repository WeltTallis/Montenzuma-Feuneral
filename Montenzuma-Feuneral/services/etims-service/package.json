{
  "name": "@montezuma/etims-service",
  "version": "1.0.0",
  "private": true,
  "description": "Typed KRA eTIMS OSCU and VSCU integration service",
  "main": "dist/src/sdk/index.js",
  "types": "dist/src/sdk/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/src/sdk/index.d.ts",
      "require": "./dist/src/sdk/index.js",
      "default": "./dist/src/sdk/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "start": "node dist/server.js",
    "worker": "node dist/workers/salesWorker.js",
    "test": "npm run build && node --test dist/tests/service.test.js dist/tests/sdk.test.js"
  },
  "dependencies": {
    "axios": "^1.6.2",
    "bullmq": "^5.81.3",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "ioredis": "^5.6.1",
    "joi": "^17.11.0",
    "winston": "^3.11.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.21",
    "@types/node": "^20.10.0",
    "typescript": "^5.3.0"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
